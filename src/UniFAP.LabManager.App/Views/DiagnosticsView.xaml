<UserControl x:Class="UniFAP.LabManager.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UniFAP.LabManager.App.ViewModels"
             xmlns:conv="clr-namespace:UniFAP.LabManager.App.Converters"
             mc:Ignorable="d" d:DesignHeight="750" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance vm:DiagnosticsViewModel}">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <conv:StepStatusToColorConverter x:Key="StatusToColor" />
        <conv:StepStatusToIconConverter x:Key="StatusToIcon" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- CABEÇALHO -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Diagnóstico do Sistema" Style="{StaticResource TitleHeader}" />
                    <TextBlock Text="Auditoria minuciosa de integridade de hardware, sistema operacional, rede e segurança." Style="{StaticResource SubtitleHeader}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding FixableProblemsCount, StringFormat='⚡ Corrigir Todos os Problemas ({0})'}"
                            Command="{Binding FixAllCommand}"
                            Style="{StaticResource SuccessButton}"
                            Margin="0,0,10,0"
                            Padding="16,10"
                            Visibility="{Binding HasFixableProblems, Converter={StaticResource BoolToVis}}" />
                    <Button Content="↻ Executar Diagnóstico" Command="{Binding RunDiagnosticsCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- ESTADO INICIAL / VAZIO (QUANDO REPORT AINDA É NULO) -->
            <Border Style="{StaticResource CardPanel}" Padding="32" Margin="0,0,0,18"
                    Visibility="{Binding Report, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🩺" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="Nenhuma auditoria executada nesta sessão" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Clique no botão '↻ Executar Diagnóstico' acima para auditar hardware, sistema, rede, Active Directory e segurança." Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" MaxWidth="550" TextWrapping="Wrap" LineHeight="20" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- FILTRO DE CATEGORIAS -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,18"
                          Visibility="{Binding Report, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,6" FontSize="12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- LISTA DE CHECAGENS -->
            <ItemsControl ItemsSource="{Binding FilteredChecks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- STATUS ICON -->
                                <TextBlock Grid.Column="0" Text="{Binding Status, Converter={StaticResource StatusToIcon}}" Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />

                                <!-- NOME E CATEGORIA -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>

                                <!-- MENSAGEM, DICA E FEEDBACK DA REMEDIAÇÃO -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding Message}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ResolutionHint, StringFormat='💡 Dica: {0}'}" FontSize="11" Foreground="{StaticResource AccentBrush}" Visibility="{Binding ResolutionHint, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding RemediationFeedback}" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Visibility="{Binding RemediationFeedback, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- VALOR / STATUS BADGE -->
                                <Border Grid.Column="3" Background="{StaticResource SurfaceLightBrush}" CornerRadius="6" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Border>

                                <!-- BOTÃO DE CORREÇÃO RÁPIDA OU ESTADO CORRIGINDO -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Indicador quando está executando remediação -->
                                    <Border Background="#1E3A8A" CornerRadius="6" Padding="12,6" Visibility="{Binding IsRemediating, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⏳" Margin="0,0,6,0" FontSize="11" />
                                            <TextBlock Text="Corrigindo..." FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Botão de Correção com 1 Clique -->
                                    <Button Content="{Binding RemediationTitle, StringFormat='⚡ {0}'}"
                                            Command="{Binding FixCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="14,6"
                                            FontSize="11"
                                            Visibility="{Binding ShowRemediationButton, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
