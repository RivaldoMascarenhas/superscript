<UserControl x:Class="UniFAP.LabManager.App.Views.SoftwareCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UniFAP.LabManager.App.ViewModels"
             xmlns:conv="clr-namespace:UniFAP.LabManager.App.Converters"
             mc:Ignorable="d" d:DesignHeight="850" d:DesignWidth="1180"
             d:DataContext="{d:DesignInstance vm:SoftwareCatalogViewModel}">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StepStatusToColorConverter x:Key="StatusToColor" />
        <conv:StepStatusToIconConverter x:Key="StatusToIcon" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28">
        <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch">

            <!-- CABEÇALHO E AÇÕES GLOBAIS -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Catálogo de Softwares UniFAP" Style="{StaticResource TitleHeader}" />
                    <TextBlock Text="Catálogo institucional unificado e sincronizado com WinUtil para seleção e provisionamento sob demanda." Style="{StaticResource SubtitleHeader}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Sincronizar Catálogo WinUtil"
                            Command="{Binding SyncCatalogCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="14,8" FontSize="13" Margin="0,0,10,0"
                            ToolTip="Baixa e mescla o catálogo oficial de softwares WinUtil preservando as configurações prioritárias da UniFAP." />
                    <Button Content="🚀 Instalar Selecionados"
                            Command="{Binding InstallSelectedCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="16,8" FontSize="13" />
                </StackPanel>
            </Grid>

            <!-- BARRA DE STATUS / NOTIFICAÇÃO -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ℹ️ " FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OperationStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selecionados'}" 
                                   Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <Button Content="Selecionar Visíveis" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" />
                        <Button Content="Limpar Seleção" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BUSCA E FILTRO DE ORIGEM -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" 
                         ToolTip="Pesquise por nome do programa, categoria ou descrição..." />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Origem:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" 
                                        Command="{Binding DataContext.SelectSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Margin="0,0,6,0" Padding="12,5" FontSize="11" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- FILTRO DE CATEGORIAS -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,20">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" 
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    CommandParameter="{Binding}" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Margin="0,0,6,0" Padding="12,5" FontSize="11" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- GRID DE CARDS DE SOFTWARES -->
            <ItemsControl ItemsSource="{Binding FilteredItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="345" Style="{StaticResource CardPanel}" Margin="0,0,16,16" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- TOPO DO CARD: CHECKBOX, NOME E BADGES -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="14" 
                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <!-- BADGE OPEN SOURCE -->
                                        <Border Visibility="{Binding IsOpenSource, Converter={StaticResource BoolToVis}}" 
                                                Background="#2E7D32" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                            <TextBlock Text="FOSS" FontSize="9" FontWeight="Bold" Foreground="White" />
                                        </Border>

                                        <!-- BADGE ORIGEM -->
                                        <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="3" Padding="5,1">
                                            <TextBlock Text="{Binding Source}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- CORPO: CATEGORIA, TIPO E DESCRIÇÃO -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Type, StringFormat='({0})'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                                               TextWrapping="Wrap" Height="36" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- RODAPÉ DO CARD: STATUS E BOTÕES DE AÇÃO -->
                                <Grid Grid.Row="2">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToIcon}}" 
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" 
                                                   FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Status}" FontSize="11" 
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- LINK OFICIAL SE HOUVER -->
                                        <Button Content="🌐" 
                                                Command="{Binding DataContext.OpenOfficialLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding OfficialLink}" 
                                                Style="{StaticResource SecondaryButton}" Padding="6,4" FontSize="11" Margin="0,0,4,0"
                                                ToolTip="Abrir site oficial do projeto" />

                                        <Button Content="Reparar" 
                                                Command="{Binding DataContext.RepairSingleSoftwareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" 
                                                Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,4,0" />

                                        <Button Content="Instalar" 
                                                Command="{Binding DataContext.InstallSingleSoftwareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" 
                                                Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
